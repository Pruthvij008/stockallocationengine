# URL of the Flask ML service (fly.py).
# Local: http://localhost:5000  |  On Render this is set automatically via render.yaml
# (a bare hostname is fine — the app prepends https:// itself).
FLASK_SERVER_URL=http://localhost:5000

# Port the Express server listens on (the host sets PORT automatically in prod).
PORT=8080

# Origin allowed by CORS — the frontend URL.
# Local: http://localhost:5173  |  On Render this is set automatically via render.yaml.
CLIENT_ORIGIN=http://localhost:5173

# Only needed by flyprev.py (the earlier FRED-based ML variant)
FRED_API_KEY=your-fred-api-key
